# Copiez ce fichier en « .env » et changez les valeurs.

# Premier compte administrateur (créé au premier démarrage seulement)
ADMIN_PHONE=0800000000
ADMIN_PASSWORD=change-moi-tout-de-suite

# Adresse publique du site (utilisée dans les liens de suivi envoyés par SMS)
PUBLIC_URL=http://localhost:3000

# 1 = créer les comptes et données de démonstration au démarrage (pour tester seulement)
SEED_DEMO=0

# Mettre 1 quand le site est en HTTPS (serveur en ligne)
COOKIE_SECURE=0

# Envoi des vrais SMS : adresse d'un service qui reçoit {"to": "...", "message": "..."} en POST.
# Vide = les SMS sont seulement enregistrés (menu « Notifications » du back office).
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Envoi des vrais e-mails (SMTP). Vide = les e-mails sont seulement enregistrés.
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=ton.adresse@gmail.com,
# SMTP_PASS=mot de passe d'application Google (pas ton mot de passe normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fenix Delivery <ton.adresse@gmail.com>"
