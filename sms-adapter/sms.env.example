# Copier en /opt/fenix/sms.env (chmod 600). NE JAMAIS mettre ce fichier dans GitHub.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Expéditeur : un nom (alphanumérique, ex. FENIX) est conseillé pour la RDC.
TWILIO_FROM=FENIX
# Ou bien un Messaging Service Twilio (MG…), qui remplace TWILIO_FROM :
TWILIO_MESSAGING_SERVICE_SID=
# Le même jeton que SMS_WEBHOOK_TOKEN dans /opt/fenix/.env
SMS_WEBHOOK_TOKEN=
DEFAULT_COUNTRY_CODE=243
# 1 = enlever les accents (SMS 2 à 3 fois moins cher), 0 = garder les accents
SMS_ASCII=1
